# Ignore Python virtual environment
venv/

# Ignore Python bytecode and cache
__pycache__/
*.pyc

# Ignore OS and IDE files
.DS_Store
*.log
*.env

# Ignore uploaded files
static/*.mp3
static/*.wav
static/*.jpg
static/*.jpeg
static/*.png

# Ignore downloaded model weights / caches
.cache/
flask_session/

# Ignore the persisted RAG index -- runtime state, not source
backend/rag_store/